digraph Motor {
  graph [rankdir=TB, bgcolor="white", nodesep=0.32, ranksep=0.58, pad=0.18, splines=polyline];
  node [shape=record, fontname="Arial", fontsize=17, color="#475569", penwidth=1.3, margin="0.13,0.10"];
  edge [fontname="Arial", fontsize=12, color="#475569", arrowsize=0.85];
  Partida [label="{Partida|- maquina1: IMaquina\l- maquina2: IMaquina\l- mazo: MazoPersonajes\l|+ getFase(): int\l}"];
  IMaquina [label="{«interface»\nIMaquina|+ getNombre(): String\l}"];
  Maquina1 [label="{Maquina1|- tablero: TableroCandidatos\l- mazo: MazoPersonajes\l}"];
  Maquina2 [label="{Maquina2|- tablero: TableroCandidatos\l- mazo: MazoPersonajes\l}"];
  EstrategiaMaquina [label="{«enum»\nEstrategiaMaquina|AGRESIVA\lEQUILIBRADA\l|~ porcentajeRiesgo(d: int): double\l}"];
  IArbitroTurno [label="{«interface»\nIArbitroTurno|+ comprobarIntento(id: int): boolean\l}"];
  TableroCandidatos [label="{TableroCandidatos|- mazo: MazoPersonajes\l- vivo: boolean[]\l- cantidadViva: int\l|+ getCantidadViva(): int\l}"];
  ITableroCandidatos [label="{«interface»\nITableroCandidatos|+ estaVivo(id: int): boolean\l+ getCantidadViva(): int\l}"];
  Partida -> IMaquina [arrowhead=vee, label="dos roles 0..1"];
  IMaquina -> Maquina1 [style=dashed, dir=back, arrowtail=empty];
  IMaquina -> Maquina2 [style=dashed, dir=back, arrowtail=empty];
  {rank=same; Maquina1; Maquina2;}
  Partida -> IArbitroTurno [style=dashed, arrowhead=vee, label="crea implementación"];
  IMaquina -> IArbitroTurno [style=dashed, arrowhead=vee];
  Maquina1 -> EstrategiaMaquina [style=dashed, arrowhead=vee];
  Maquina2 -> EstrategiaMaquina [style=dashed, arrowhead=vee];
  Maquina1 -> TableroCandidatos [arrowhead=vee, label="tablero 1"];
  Maquina2 -> TableroCandidatos [arrowhead=vee, label="tablero 1"];
  TableroCandidatos -> ITableroCandidatos [style=dashed, arrowhead=empty];
}

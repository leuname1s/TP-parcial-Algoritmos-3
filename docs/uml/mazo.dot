digraph Mazo {
  graph [rankdir=TB, bgcolor="white", nodesep=0.32, ranksep=0.58, pad=0.18, splines=polyline];
  node [shape=record, fontname="Arial", fontsize=17, color="#475569", penwidth=1.3, margin="0.13,0.10"];
  edge [fontname="Arial", fontsize=12, color="#475569", arrowsize=0.85];
  MazoPersonajes [label="{MazoPersonajes|- cabeza: Nodo\l- cola: Nodo\l- indicePorId: Personaje[]\l|+ ordenarPorGenero(): void\l+ buscarPorId(id: int): Personaje\l}"];
  IMazoPersonajes [label="{«interface»\nIMazoPersonajes|+ agregar(p: Personaje): void\l+ ordenarPorGenero(): void\l}"];
  Iterable [label="{«interface Java»\nIterable\<Personaje\>|+ iterator(): Iterator\<Personaje\>\l}"];
  Nodo [label="{Nodo|~ dato: Personaje\l~ siguiente: Nodo\l}"];
  Personaje [label="{Personaje|- id: int\l- nombre: String\l- genero: Genero\l- colorPelo: ColorPelo\l|+ getId(): int\l}"];
  TableroCandidatos -> MazoPersonajes [arrowhead=vee, label="mazo 1"];
  Partida -> MazoPersonajes [arrowhead=vee, label="mazo 0..1", constraint=false];
  MazoPersonajes -> IMazoPersonajes [style=dashed, arrowhead=empty];
  IMazoPersonajes -> Iterable [arrowhead=empty];
  MazoPersonajes -> Nodo [dir=both, arrowtail=diamond, arrowhead=none, taillabel="1", headlabel="0..*", label="nodos"];
  Nodo -> Personaje [arrowhead=vee, headlabel="1", label="dato"];
  Nodo -> Nodo [arrowhead=vee, label="siguiente 0..1"];
}

digraph Aplicacion {
  graph [rankdir=TB, bgcolor="white", nodesep=0.38, ranksep=0.60, pad=0.18, splines=polyline];
  node [shape=record, fontname="Arial", fontsize=17, color="#475569", penwidth=1.3, margin="0.13,0.10"];
  edge [fontname="Arial", fontsize=12, color="#475569", arrowsize=0.85];
  ControladorJuego [label="{ControladorJuego|- partida: IPartida\l- vista: IVistaJuego\l- servicio: ServicioEstadisticas\l|+ abrir(): void\l}"];
  IPartida [label="{«interface»\nIPartida|+ getResultado(): ResultadoPartida\l}"];
  Partida [label="{Partida|- estado: EstadoPartida\l- fase: int\l|+ iniciar(modo: ModoJuego): void\l}"];
  IVistaJuego [label="{«interface»\nIVistaJuego|+ cerrar(): void\l}"];
  VentanaPrincipal [label="{VentanaPrincipal|- controlador: ControladorJuego\l|+ cerrar(): void\l}"];
  JFrame [label="{JFrame|«biblioteca Swing»}"];
  EstadoVistaJuego [label="{EstadoVistaJuego|«instantánea inmutable»}"];
  ServicioEstadisticas [label="{ServicioEstadisticas|- repositorio: IRepositorioEstadisticas\l|+ consultarMaquinas(): Estadisticas\l}"];
  IRepositorioEstadisticas [label="{«interface»\nIRepositorioEstadisticas|+ cargar(): Properties\l+ guardar(r: Properties): void\l}"];
  RepositorioEstadisticasArchivo [label="{RepositorioEstadisticasArchivo|+ cargar(): Properties\l+ guardar(r: Properties): void\l}"];
  {rank=same; IPartida; IVistaJuego; ServicioEstadisticas;}
  {rank=same; Partida; VentanaPrincipal; IRepositorioEstadisticas;}
  {rank=same; EstadoVistaJuego; JFrame; RepositorioEstadisticasArchivo;}
  ControladorJuego -> IPartida [arrowhead=vee, label="partida 1"];
  ControladorJuego -> IVistaJuego [arrowhead=vee, label="vista 1"];
  IPartida -> Partida [style=dashed, dir=back, arrowtail=empty];
  IVistaJuego -> VentanaPrincipal [style=dashed, dir=back, arrowtail=empty];
  VentanaPrincipal -> JFrame [arrowhead=empty];
  VentanaPrincipal -> ControladorJuego [arrowhead=vee, label="controlador 0..1", constraint=false];
  ControladorJuego -> EstadoVistaJuego [style=dashed, arrowhead=vee, label="crea"];
  ControladorJuego -> ServicioEstadisticas [arrowhead=vee, label="servicio 1"];
  IVistaJuego -> EstadoVistaJuego [style=dashed, arrowhead=vee, constraint=false];
  ServicioEstadisticas -> IRepositorioEstadisticas [arrowhead=vee, label="repositorio 1"];
  IRepositorioEstadisticas -> RepositorioEstadisticasArchivo [style=dashed, dir=back, arrowtail=empty];
}
